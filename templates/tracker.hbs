<div class="ee-body">
    <div class="ee-summary {{#if dead}}dead{{/if}}">
        <div class="ee-level">
            {{#if editable}}
            <button type="button" class="ee-step" data-action="adjustLevel" data-delta="-1"
                    data-tooltip="EXTENDED_EXHAUSTION.Tracker.Decrease"
                    aria-label="{{ localize 'EXTENDED_EXHAUSTION.Tracker.Decrease' }}">
                <i class="fa-solid fa-minus" inert></i>
            </button>
            {{/if}}
            <div class="ee-level-value">
                <span class="ee-level-current">{{#if immune}}&mdash;{{else}}{{ level }}{{/if}}</span>
                <span class="ee-level-max">/ {{ max }}</span>
            </div>
            {{#if editable}}
            <button type="button" class="ee-step" data-action="adjustLevel" data-delta="1"
                    {{#if atMax}}disabled{{/if}}
                    data-tooltip="EXTENDED_EXHAUSTION.Tracker.Increase"
                    aria-label="{{ localize 'EXTENDED_EXHAUSTION.Tracker.Increase' }}">
                <i class="fa-solid fa-plus" inert></i>
            </button>
            {{/if}}
        </div>

        <div class="ee-summary-meta">
            <p class="ee-method">{{ methodLabel }}</p>
            {{#if immune}}
            <p class="ee-note immune">{{ localize "EXTENDED_EXHAUSTION.Tooltip.Immune" }}</p>
            {{else if dead}}
            <p class="ee-note dead">{{ localize "EXTENDED_EXHAUSTION.Tracker.Dead" }}</p>
            {{else if recoveryDC}}
            <p class="ee-note">{{ localize "EXTENDED_EXHAUSTION.Tracker.NextRecoveryDC" }} <strong>{{ recoveryDC }}</strong></p>
            {{/if}}
        </div>
    </div>

    <ol class="ee-tracks">
        {{#each tracks}}
        <li class="ee-track {{#if marks}}marked{{/if}}" data-track="{{ id }}">
            <i class="ee-track-icon {{ icon }}" inert></i>
            <div class="ee-track-name">
                <span class="ee-track-label">{{ label }}</span>
                <span class="ee-track-hint">{{ hint }}</span>
            </div>
            <div class="ee-track-marks">
                {{#if @root.choice}}
                {{#if @root.editable}}
                <button type="button" class="ee-step small" data-action="adjustTrack" data-track="{{ id }}" data-delta="-1"
                        aria-label="{{ localize 'EXTENDED_EXHAUSTION.Tracker.Decrease' }}">
                    <i class="fa-solid fa-minus" inert></i>
                </button>
                {{/if}}
                <input type="number" name="marks.{{ id }}" value="{{ marks }}" min="0" step="1"
                       max="{{ @root.rows }}"
                       {{#unless @root.editable}}readonly{{/unless}}>
                {{#if @root.editable}}
                <button type="button" class="ee-step small" data-action="adjustTrack" data-track="{{ id }}" data-delta="1"
                        {{#if full}}disabled{{/if}}{{#if @root.atMax}} disabled{{/if}}
                        aria-label="{{ localize 'EXTENDED_EXHAUSTION.Tracker.Increase' }}">
                    <i class="fa-solid fa-plus" inert></i>
                </button>
                {{/if}}
                {{else}}
                <span class="ee-track-count">{{ marks }}</span>
                {{/if}}
            </div>
            <div class="ee-track-penalty">{{ penalty }}</div>
        </li>
        {{/each}}
    </ol>

    {{#if choice}}
    <p class="ee-hint">{{ localize "EXTENDED_EXHAUSTION.Tracker.ChoiceHint" }}</p>
    {{else}}
    <p class="ee-hint">{{ localize "EXTENDED_EXHAUSTION.Tracker.SequentialHint" }}</p>
    {{/if}}
    <p class="ee-hint">{{ localize "EXTENDED_EXHAUSTION.Tracker.Scale" rows=rows speed=speedStep zeroAt=zeroAt }}</p>

    <footer class="ee-footer">
        {{#if spending}}
        <button type="button" data-action="spend">
            <i class="fa-solid fa-fire-flame-curved" inert></i>
            {{ localize "EXTENDED_EXHAUSTION.Tracker.Spend" }}
        </button>
        {{/if}}
        {{#if editable}}
        <button type="button" data-action="longRest" {{#unless level}}disabled{{/unless}}>
            <i class="fa-solid fa-bed" inert></i>
            {{ localize "EXTENDED_EXHAUSTION.Tracker.LongRest" }}
        </button>
        {{/if}}
        {{#if isGM}}
        <button type="button" data-action="clear" {{#unless level}}disabled{{/unless}}>
            <i class="fa-solid fa-broom" inert></i>
            {{ localize "EXTENDED_EXHAUSTION.Tracker.Clear" }}
        </button>
        {{/if}}
    </footer>
</div>
